# ==============================================================================
# Uganda Academic Document Marketplace - Environment Configuration (.env.example)
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth & PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Document Storage (Cloudflare R2 or S3-Compatible Storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=uganda-academic-docs
R2_PUBLIC_DOMAIN=
STORAGE_PROVIDER=local_or_r2 # set to 'local' for development / 'r2' for production

# Mobile Money Providers (Uganda - MarzPay, MTN MoMo & Airtel Money)
PAYMENT_MODE=sandbox # 'sandbox' | 'production'
UGANDA_PAYMENT_GATEWAY=marzpay # 'marzpay' | 'simulated'
UGANDA_MOMO_PROVIDER=marzpay

# MarzPay Uganda Gateway Credentials (https://wearemarz.com)
MARZPAY_BASE_URL=https://wallet.wearemarz.com/api/v1
MARZPAY_API_KEY=your-marzpay-api-key
MARZPAY_API_SECRET=your-marzpay-api-secret
MARZPAY_AUTH_HEADER=your-base64-auth-header
MARZPAY_WEBHOOK_SECRET=your-marzpay-webhook-secret

# MTN Mobile Money Open API Credentials (Direct fallback)
MTN_MOMO_PRIMARY_KEY=your-mtn-subscription-key
MTN_MOMO_USER_ID=your-mtn-api-user-id
MTN_MOMO_API_KEY=your-mtn-api-key
MTN_MOMO_TARGET_ENV=sandbox # 'sandbox' | 'mtnuganda'
MTN_MOMO_WEBHOOK_SECRET=your-mtn-webhook-signing-secret

# Airtel Money OpenAPI Credentials
AIRTEL_MONEY_CLIENT_ID=your-airtel-client-id
AIRTEL_MONEY_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_MONEY_PUBLIC_KEY=your-airtel-public-key
AIRTEL_MONEY_WEBHOOK_SECRET=your-airtel-webhook-secret

# Platform Financial Settings (Configurable snapshots)
PLATFORM_COMMISSION_PERCENTAGE=15 # e.g., 15% platform fee, 85% lecturer net earnings
MINIMUM_LECTURER_PAYOUT_UGX=10000 # Minimum payout threshold in UGX
MINIMUM_DEPOSIT_UGX=1000 # Minimum deposit in UGX
MINIMUM_DOCUMENT_PRICE_UGX=500 # Minimum document price in UGX
MAXIMUM_DOCUMENT_PRICE_UGX=100000 # Maximum document price in UGX

